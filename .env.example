# Set a unique password (at least 12 characters) to enable organizer sign-in.
ADMIN_PASSWORD=
# Set a random secret (at least 32 characters) to sign organizer sessions.
SESSION_SECRET=
# Optional absolute path to a persistent volume. Defaults to ./data.
DATA_DIR=

# Authorized Administrator email for Google OAuth
ADMIN_EMAIL=lester.chquezonprovince@gmail.com

# Google OAuth 2.0 Credentials (from Google Cloud Console -> Create OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
